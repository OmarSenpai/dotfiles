{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/omar/.config/fastfetch/logos/torchlib.png",
    "width": 20,
    "preserveAspectRatio": true,
    "padding": {
      "right": 4,
      "left": 3,
      "top": 3,
    },
  },
  "general": {
    "multithreading": true,
  },
  "display": {
    "separator": "リ   ",
  },
  "modules": [
    /*"break",
    {
      "type": "title",
      "format": "                                {6}{7}{8}",
    },*/
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────╮", // `\u001b` is `\033`, or `\e`
    },
    "break",
    {
      "key": " OS           ",
      "keyColor": "white",
      "type": "os",
      "format": "{2}"
    },
    /*{
      "key": "    󰌢 Machine      ",
      "keyColor": "cyan",
      "type": "host",
    },*/
    {
      "key": " Kernel       ",
      "keyColor": "white",
      "type": "kernel",
    },
    {
      "key": " Display      ",
      "keyColor": "white",
      "type": "display",
      "format": "{1}x{2}@{3}Hz"
    },
    {
      "key": " Packages     ",
      "keyColor": "white",
      "type": "packages",
    },
    {
      "key": " WM           ",
      "keyColor": "white",
      "type": "wm",
    },
    {
      "key": " DE           ",
      "keyColor": "white",
      "type": "de",
      "format": "{1}{4}"
    },
    {
      "key": " Theme        ",
      "keyColor": "cyan",
      "type": "wmtheme",
    },
    {
      "key": " Shell        ",
      "keyColor": "white",
      "type": "shell",
    },
    {
      "key": " Terminal     ",
      "keyColor": "white",
      "type": "terminal",
    },
    /*{
      "key": "     Font         ",
      "keyColor": "cyan",
      "type": "terminalfont",
    },
    {
      "key": " CPU          ",
      "keyColor": "white",
      "type": "cpu",
      "format": "{1}"
    },
    {
      "key": " GPU          ",
      "keyColor": "white",
      "type": "gpu",
      "format": "{1} {2}"
    },
    {
      "key": "    🖴 Disk         ",
      "keyColor": "cyan",
      "type": "disk",
    },
    {
      "key": "    🖫 Swap         ",
      "keyColor": "white",
      "type": "swap",
    },
    {
      "key": "    󰑭 Memory       ",
      "keyColor": "white",
      "type": "memory",
    },
    {
      "key": "     Wifi         ",
      "keyColor": "cyan",
      "type": "localip",
    },
    {
      "key": "     UpTime       ",
      "keyColor": "white",
      "type": "uptime",
    },*/
    "break",
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────╯", // `\u001b` is `\033`, or `\e`
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 34,
      "symbol": "circle",
      "block": {
        "width": 10,
      },
    },
  ],
}
/*
╭  (top-left corner)
╮  (top-right corner)
╰  (bottom-left corner)
╯  (bottom-right corner)
─  (horizontal line)
│  (vertical line)
*/
